│   │       └── AuthModal.jsx       # Auth modal wrapper
│   ├── contexts/
│   │   └── authContext.jsx         # Global auth state
│   ├── lib/
│   │   └── api-config.js           # Axios instance with interceptors
│   └── services/
│       ├── videoService.js         # Video API calls
│       └── userService.js          # User API calls
├── .env.local
├── next.config.mjs
└── package.json
```

